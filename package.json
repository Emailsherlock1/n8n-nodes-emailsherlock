{
  "name": "n8n-nodes-emailsherlock",
  "version": "0.1.1",
  "description": "n8n community node for the EmailSherlock email verification API.",
  "keywords": [
    "n8n-community-node-package",
    "email",
    "email-verification",
    "email-validation",
    "emailsherlock",
    "mx",
    "smtp",
    "disposable"
  ],
  "license": "MIT",
  "homepage": "https://emailsherlock.com/api",
  "author": {
    "name": "EmailSherlock",
    "url": "https://emailsherlock.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Emailsherlock1/n8n-nodes-emailsherlock.git"
  },
  "bugs": {
    "url": "https://github.com/Emailsherlock1/n8n-nodes-emailsherlock/issues"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "test": "npm run build && node --test test/node.test.mjs",
    "test:e2e": "npm run build && node --test test/e2e-sandbox.test.mjs",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/EmailSherlockApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/EmailSherlock/EmailSherlock.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "gulp": "^5.0.0",
    "n8n-workflow": "1.119.1",
    "prettier": "^3.3.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
